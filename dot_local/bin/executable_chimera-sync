#!/usr/bin/env python3
"""
chimera-sync: track and cherry-pick upstream Chimera cports commits into a
cports fork that carries only a subset of the packages.

A commit is relevant when it touches a package we carry (in any category,
so upstream user/foo maps to our main/foo) or anything outside the package
categories (cbuild, etc, ci, docs). A commit counts as applied when one of
our commits carries its "(cherry picked from commit X)" line, has the same
author, author date and subject (what cherry-pick preserves), or has the
same patch-id, or when its content is already there: every file it
touches already matches upstream's current version (so it was applied, or
upstream changed or reverted it later), or its patch applies in reverse.
pick checks this too, and lints the packages it touched with cbuild.
Commits can also be marked as skipped in a file tracked in the cports
repository (.skipped-upstream-commits at its top level, or the path in
$CHIMERA_SYNC_SKIP), so it is committed and shared like any other change.

Commands:
  pending          list relevant commits that were not applied (default)
  show HASH        show the patch that pick would apply
  pick HASH...     apply commits (only the relevant paths, remapped)
  pick --pending   apply pending commits in order, stop on first failure
  continue         commit a pick after resolving conflicts and go on
  abort            drop a pick in progress and the rest of the queue
  skip HASH...     record commits that should not be picked
"""

import argparse
import json
import os
import re
import subprocess
import sys

CATEGORIES = ("main", "user", "contrib")
SKIPFILE = ".skipped-upstream-commits"
PICKED_RE = re.compile(r"cherry picked from commit ([0-9a-f]{7,40})")


def git(*args, check=True, input=None, binary=False):
    res = subprocess.run(
        ["git", "-c", "core.quotePath=false", *args],
        capture_output=True,
        input=input,
        text=not binary,
        check=False,
    )
    if check and res.returncode != 0:
        err = res.stderr if not binary else res.stderr.decode()
        sys.exit(f"git {' '.join(args)} failed:\n{err.strip()}")
    return res


def gitout(*args):
    return git(*args).stdout


class Commit:
    def __init__(self, sha, email, date, subject):
        self.sha = sha
        self.email = email
        self.date = date
        self.subject = subject
        # (oldmode, newmode, newsha, status, path)
        self.changes = []
        self.keep = []  # original paths to apply
        self.rename = {}  # original package path prefix -> ours
        self.dropped = set()  # packages we do not carry
        self.tags = set()

    @property
    def short(self):
        return self.sha[:9]


def parse_log(rng):
    out = gitout(
        "log",
        "--no-merges",
        "--reverse",
        "--topo-order",
        "--raw",
        "--no-renames",
        "--no-abbrev",
        "--format=commit %H%x09%ae%x09%at%x09%s",
        rng,
    )
    commits = []
    cur = None
    for ln in out.splitlines():
        if ln.startswith("commit "):
            sha, email, date, subj = ln[7:].split("\t", 3)
            cur = Commit(sha, email, date, subj)
            commits.append(cur)
        elif ln.startswith(":") and cur:
            meta, path = ln.split("\t", 1)
            omode, nmode, _, nsha, status = meta[1:].split()
            cur.changes.append((omode, nmode, nsha, status, path))
    return commits


def our_packages(head):
    pkgs = {}
    out = gitout("ls-tree", head, *(f"{c}/" for c in CATEGORIES))
    for ln in out.splitlines():
        path = ln.split("\t", 1)[1]
        cat, name = path.split("/", 1)
        pkgs[name] = cat
    return pkgs


def symlink_targets(shas):
    if not shas:
        return {}
    res = git("cat-file", "--batch", input="\n".join(shas) + "\n", binary=False).stdout
    targets = {}
    lines = iter(res.split("\n"))
    for hdr in lines:
        if not hdr:
            continue
        sha, _, size = hdr.split()
        targets[sha] = next(lines)[: int(size)]
    return targets


def classify(commits, pkgs):
    # new top-level symlinks (subpackages) need their target resolved
    links = set()
    for c in commits:
        for omode, nmode, nsha, status, path in c.changes:
            parts = path.split("/")
            if (
                len(parts) == 2
                and parts[0] in CATEGORIES
                and nmode == "120000"
                and parts[1] not in pkgs
            ):
                links.add(nsha)
    targets = symlink_targets(sorted(links))

    for c in commits:
        for omode, nmode, nsha, status, path in c.changes:
            parts = path.split("/")
            if parts[0] not in CATEGORIES or len(parts) < 2:
                c.keep.append(path)
                c.tags.add("cbuild" if parts[0] == "src" else "infra")
                continue
            cat, name = parts[0], parts[1]
            ours = pkgs.get(name)
            if not ours and nmode == "120000" and len(parts) == 2:
                tgt = targets.get(nsha, "")
                if tgt in pkgs:
                    ours = pkgs[tgt]
            if not ours:
                c.dropped.add(f"{cat}/{name}")
                continue
            c.keep.append(path)
            if ours != cat:
                c.rename[f"{cat}/{name}"] = f"{ours}/{name}"
                c.tags.add(f"{cat}->{ours}")
        if c.keep and c.dropped:
            c.tags.add("partial")
            if "cbuild" in c.tags and not c.subject.startswith("cbuild"):
                # cbuild changes hidden in a package commit
                c.tags.add("CBUILD-IN-PKG")
        # upstream moved one of our packages between categories; after
        # remapping, the removal and the addition hit the same paths
        if any(
            p.startswith(v + "/") or p == v for v in c.rename.values() for p in c.keep
        ):
            c.tags.add("category-move")


def gitdir():
    return gitout("rev-parse", "--git-dir").strip()


def load_skips(path):
    skips = {}
    if not os.path.exists(path):
        return skips
    with open(path) as f:
        for ln in f:
            ln = ln.strip()
            if not ln or ln.startswith("#"):
                continue
            h = ln.split()[0]
            r = git("rev-parse", "--verify", "-q", h + "^{commit}", check=False)
            if r.returncode != 0:
                print(f"warning: unknown commit {h} in {path}", file=sys.stderr)
                continue
            skips[r.stdout.strip()] = ln
    return skips


def applied_set(base, head, candidates):
    applied = dict.fromkeys(trailer_shas(base, head), "trailer")

    keys = set(
        gitout(
            "log", "--no-merges", "--format=%ae%x09%at%x09%s", f"{base}..{head}"
        ).splitlines()
    )
    for c in candidates:
        if c.sha not in applied and f"{c.email}\t{c.date}\t{c.subject}" in keys:
            applied[c.sha] = "author+date"

    left = [c for c in candidates if c.sha not in applied]
    if left:
        ours = patch_ids(["log", "-p", "--no-merges", f"{base}..{head}"])
        theirs = patch_ids(["show", "-p", "--format=commit %H", *(c.sha for c in left)])
        known = set(ours)
        for pid, sha in theirs.items():
            if pid in known:
                applied[sha] = "patch-id"
    return applied


def patch_ids(cmd):
    diff = git(*cmd, binary=True).stdout
    out = subprocess.run(
        ["git", "patch-id", "--stable"],
        input=diff,
        capture_output=True,
        check=False,
    ).stdout.decode()
    return dict(ln.split() for ln in out.splitlines())


class Repo:
    def __init__(self, args):
        os.chdir(gitout("rev-parse", "--show-toplevel").strip())
        self.args = args
        self.head = "HEAD"
        self.upstream = args.upstream
        self.base = args.base or gitout("merge-base", self.head, self.upstream).strip()
        self.skipfile = args.skip_file or os.path.join(os.getcwd(), SKIPFILE)
        self.pkgs = our_packages(self.head)

    def pending(self, with_applied=False):
        commits = parse_log(f"{self.base}..{self.upstream}")
        classify(commits, self.pkgs)
        relevant = [c for c in commits if c.keep]
        applied = applied_set(self.base, self.head, relevant)
        skips = load_skips(self.skipfile)
        stats = {
            "upstream": len(commits),
            "irrelevant": len(commits) - len(relevant),
            "applied": sum(1 for c in relevant if c.sha in applied),
            "skipped": sum(
                1 for c in relevant if c.sha in skips and c.sha not in applied
            ),
        }
        pend = [c for c in relevant if c.sha not in applied and c.sha not in skips]
        for c in pend:
            how = self.content_applied(c)
            if how:
                applied[c.sha] = how
        stats["applied"] += sum(1 for c in pend if c.sha in applied)
        pend = [c for c in pend if c.sha not in applied]
        stats["pending"] = len(pend)
        return pend, stats, applied

    def content_applied(self, c):
        if self.in_sync(c):
            return "in-sync"
        if self.reverse_applies(c):
            return "content"
        return None

    def in_sync(self, c):
        """Every file the commit touches (missing counts too) is the same
        here and in upstream's current tree."""
        specs = []
        for p in c.keep:
            specs += [f"{self.head}:{ours_path(c, p)}", f"{self.upstream}:{p}"]
        out = git(
            "cat-file", "--batch-check=%(objectname)", input="\n".join(specs) + "\n"
        ).stdout.splitlines()
        objs = [None if ln.endswith(" missing") else ln for ln in out]
        return all(objs[i] == objs[i + 1] for i in range(0, len(objs), 2))

    def reverse_applies(self, c):
        idx = os.path.join(gitdir(), "chimera-sync.index")
        env = dict(os.environ, GIT_INDEX_FILE=idx)
        try:
            subprocess.run(["git", "read-tree", self.head], env=env, check=True)
            res = subprocess.run(
                ["git", "apply", "--check", "--cached", "-R", "-"],
                input=self.patch(c),
                env=env,
                capture_output=True,
                check=False,
            )
            return res.returncode == 0
        finally:
            if os.path.exists(idx):
                os.unlink(idx)

    def patch(self, c):
        diff = git(
            "diff-tree",
            "-p",
            "--binary",
            "--full-index",
            "--no-renames",
            f"{c.sha}^",
            c.sha,
            "--",
            *c.keep,
            binary=True,
        ).stdout
        if not c.rename:
            return diff
        lines = diff.split(b"\n")
        for i, ln in enumerate(lines):
            if not ln.startswith((b"diff --git ", b"--- ", b"+++ ")):
                continue
            for src, dst in c.rename.items():
                for pfx in (b"a/", b"b/"):
                    s, d = pfx + src.encode(), pfx + dst.encode()
                    ln = re.sub(re.escape(s) + rb"(?=/|$|\s)", d, ln)
            lines[i] = ln
        return b"\n".join(lines)


def ours_path(c, path):
    for src, dst in c.rename.items():
        if path == src or path.startswith(src + "/"):
            return dst + path[len(src) :]
    return path


def get_commit(repo, h):
    sha = gitout("rev-parse", "--verify", h + "^{commit}").strip()
    c = parse_log(f"{sha}^!")[0]
    classify([c], repo.pkgs)
    return c


def message(c):
    msg = gitout("log", "-1", "--format=%B", c.sha).rstrip() + "\n\n"
    msg += f"(cherry picked from commit {c.sha})\n"
    if c.rename:
        moves = ", ".join(f"{s} -> {d}" for s, d in sorted(c.rename.items()))
        msg += f"(chimera-sync: {moves})\n"
    if c.dropped:
        msg += "(chimera-sync: dropped " + ", ".join(sorted(c.dropped)) + ")\n"
    return msg


def state_path():
    return os.path.join(gitdir(), "chimera-sync.json")


def load_state():
    if not os.path.exists(state_path()):
        return None
    with open(state_path()) as f:
        st = json.load(f)
    if "mode" not in st:
        print("dropping pick state left by an older chimera-sync", file=sys.stderr)
        clear_state()
        return None
    return st


def save_state(st):
    with open(state_path(), "w") as f:
        json.dump(st, f)


def clear_state():
    if os.path.exists(state_path()):
        os.unlink(state_path())


def picking():
    return os.path.exists(os.path.join(gitdir(), "CHERRY_PICK_HEAD"))


def nothing_staged():
    return not gitout("diff", "--cached", "--name-only").strip()


def trailer_shas(base, head="HEAD"):
    shas = set()
    body = gitout("log", "--format=%B", f"{base}..{head}")
    for m in PICKED_RE.finditer(body):
        r = git("rev-parse", "--verify", "-q", m.group(1) + "^{commit}", check=False)
        if r.returncode == 0:
            shas.add(r.stdout.strip())
    return shas


def commit_meta(meta):
    if nothing_staged():
        return False
    env = dict(os.environ)
    env["GIT_AUTHOR_NAME"] = meta["name"]
    env["GIT_AUTHOR_EMAIL"] = meta["email"]
    env["GIT_AUTHOR_DATE"] = meta["date"]
    res = subprocess.run(
        ["git", "commit", "-q", "--no-verify", "-F", "-"],
        input=meta["msg"],
        text=True,
        env=env,
        check=False,
    )
    if res.returncode != 0:
        sys.exit("commit failed")
    return True


def dirty(repo):
    """Uncommitted changes, ignoring the skip file: picks never touch it,
    and 'skip' leaves it modified until the user commits it."""
    args = ["status", "--porcelain", "--untracked-files=no"]
    rel = os.path.relpath(repo.skipfile)
    if not rel.startswith(".."):
        args += ["--", ".", f":(exclude){rel}"]
    return bool(gitout(*args).strip())


def unmerged():
    return bool(gitout("diff", "--name-only", "--diff-filter=U").strip())


def require_clean(repo):
    st = load_state()
    if st:
        if picking() or unmerged() or dirty(repo):
            sys.exit("a pick is in progress, run 'continue' or 'abort'")
        # resolved or dropped behind our back (git cherry-pick --abort,
        # reset, manual commit): nothing is left to continue
        left = st.get("queue", [])
        print(
            f"dropping stale pick state (stopped at {st['current'][:9]}, "
            f"{len(left)} commits were still queued)",
            file=sys.stderr,
        )
        clear_state()
    if picking():
        sys.exit("a cherry-pick is in progress, finish it first")
    if dirty(repo):
        sys.exit("working tree has uncommitted changes")


def apply_commit(repo, c, force):
    """Returns (result, state) where result is applied, empty, refused or
    conflict; state is what 'continue' needs after a conflict."""
    if "category-move" in c.tags and not force:
        return "refused", None
    if not c.rename and not c.dropped:
        r = subprocess.run(["git", "cherry-pick", "-x", c.sha], check=False)
        if r.returncode == 0:
            return "applied", None
        if not picking():
            sys.exit(f"cherry-pick of {c.short} failed")
        return "conflict", {"mode": "cherry-pick"}
    info = gitout("log", "-1", "--format=%an%x00%ae%x00%ad", "--date=raw", c.sha)
    name, email, date = info.rstrip("\n").split("\0")
    meta = {"name": name, "email": email, "date": date, "msg": message(c)}
    res = git(
        "apply", "-3", "--index", "-", input=repo.patch(c), check=False, binary=True
    )
    if res.returncode != 0:
        sys.stderr.write(res.stderr.decode())
        return "conflict", {"mode": "apply", "meta": meta}
    return ("applied" if commit_meta(meta) else "empty"), None


REPORT = (
    ("applied", "applied"),
    ("already", "already in"),
    ("insync", "files already match upstream"),
    ("irrelevant", "nothing to pick"),
    ("empty", "empty, consider skip"),
    ("refused", "category move, not picked"),
    ("dropped", "not applied"),
)


def subject(sha):
    return gitout("log", "-1", "--format=%s", sha).strip()


def print_report(report, current=None, queue=(), stop="stopped at"):
    rows = [(label, sha) for key, label in REPORT for sha in report.get(key, [])]
    if current:
        rows.append((stop, current))
    rows += [("not picked yet", sha) for sha in queue]
    if not rows:
        return
    width = max(len(label) for label, _ in rows)
    print()
    for label, sha in rows:
        print(f"{label + ':':<{width + 1}} {sha[:9]} {subject(sha)}")


def run_queue(repo, queue, report, force=False, dry=False, lint=True):
    done = trailer_shas(repo.base)
    while queue:
        sha = queue.pop(0)
        c = get_commit(repo, sha)
        tags = ",".join(sorted(c.tags))
        print(f"==> {c.short} {c.subject}" + (f"  [{tags}]" if tags else ""))
        if dry:
            continue
        if sha in done:
            report.setdefault("already", []).append(sha)
            continue
        if not c.keep:
            report.setdefault("irrelevant", []).append(sha)
            continue
        how = None if force else repo.content_applied(c)
        if how:
            key = "insync" if how == "in-sync" else "already"
            report.setdefault(key, []).append(sha)
            continue
        res, st = apply_commit(repo, c, force)
        if res == "conflict":
            st.update(current=sha, queue=queue, report=report, force=force, lint=lint)
            save_state(st)
            print_report(report, sha, queue)
            if st["mode"] == "cherry-pick":
                how = "'git add' them (or 'git cherry-pick --continue')"
            else:
                how = "'git add' them"
            print(
                f"\nresolve the conflicts, {how} and run 'chimera-sync continue'"
                " to commit and go on with the rest, or 'chimera-sync abort'"
            )
            sys.exit(1)
        report.setdefault(res, []).append(sha)
        if res == "applied":
            done.add(sha)
    if not dry:
        print_report(report)
        if lint:
            lint_packages(repo, report.get("applied", []))
        clear_state()


def lint_packages(repo, shas):
    """Load the templates the picks touched, to catch picks that do not
    fit the current cbuild (lint does not run build-time functions)."""
    if not shas or not os.path.exists("cbuild"):
        return
    pkgs = set()
    for sha in shas:
        c = get_commit(repo, sha)
        for p in c.keep:
            parts = ours_path(c, p).split("/")
            if parts[0] in CATEGORIES and len(parts) > 2:
                pkgs.add("/".join(parts[:2]))
    pkgs = sorted(p for p in pkgs if os.path.exists(f"{p}/template.py"))
    bad = []
    for pkg in pkgs:
        r = subprocess.run(
            ["./cbuild", "lint", pkg], capture_output=True, text=True, check=False
        )
        if r.returncode != 0:
            bad.append(pkg)
            print(f"\nlint failed for {pkg}:")
            print("\n".join((r.stdout + r.stderr).strip().splitlines()[-4:]))
    if bad:
        print(f"\nlint: {len(bad)} of {len(pkgs)} packages failed: {' '.join(bad)}")
    elif pkgs:
        print(f"\nlint: {len(pkgs)} packages OK")


def cmd_continue(repo, a):
    st = load_state()
    if not st:
        sys.exit("no pick in progress")
    if gitout("diff", "--name-only", "--diff-filter=U").strip():
        sys.exit("there are still unmerged files")
    sha = st["current"]
    if st["mode"] == "cherry-pick":
        if picking():
            if nothing_staged():
                git("cherry-pick", "--skip")
                res = "empty"
            else:
                r = subprocess.run(
                    ["git", "cherry-pick", "--continue"],
                    env=dict(os.environ, GIT_EDITOR="true"),
                    check=False,
                )
                if r.returncode != 0:
                    sys.exit("git cherry-pick --continue failed")
                res = "applied"
        elif sha in trailer_shas(repo.base):
            res = "applied"
        else:
            # finished by hand with git cherry-pick --skip or --abort
            res = "dropped"
    else:
        res = "applied" if commit_meta(st["meta"]) else "empty"
    st["report"].setdefault(res, []).append(sha)
    lint = st.get("lint", True) and not a.no_lint
    run_queue(repo, st["queue"], st["report"], st["force"], lint=lint)


def cmd_abort(repo, a):
    st = load_state()
    if not st:
        sys.exit("no pick in progress")
    if picking():
        git("cherry-pick", "--abort")
    elif st["mode"] == "apply":
        git("reset", "-q", "--merge")
    clear_state()
    print_report(st["report"], st["current"], st["queue"], "aborted")


def cmd_pending(repo, a):
    pend, stats, applied = repo.pending()
    for c in pend:
        tags = ",".join(sorted(c.tags))
        date = gitout("log", "-1", "--format=%as", c.sha).strip() if a.dates else ""
        print(
            f"{c.short} {date + ' ' if date else ''}{c.subject}"
            + (f"  [{tags}]" if tags else "")
        )
        if a.files:
            for p in c.keep:
                print(f"        {p}")
            for p in sorted(c.dropped):
                print(f"      - {p}")
    how = {}
    for v in applied.values():
        how[v] = how.get(v, 0) + 1
    print(
        f"\n{stats['upstream']} upstream commits since {repo.base[:9]}: "
        f"{stats['irrelevant']} irrelevant, {stats['applied']} applied "
        f"({', '.join(f'{k} {v}' for k, v in sorted(how.items()))}), "
        f"{stats['skipped']} skipped, {stats['pending']} pending",
        file=sys.stderr,
    )


def cmd_show(repo, a):
    c = get_commit(repo, a.commit)
    sys.stdout.write(message(c))
    print(f"tags: {', '.join(sorted(c.tags)) or '-'}\n")
    sys.stdout.flush()
    sys.stdout.buffer.write(repo.patch(c))


def cmd_pick(repo, a):
    if a.pending:
        todo, _, _ = repo.pending()
        if a.limit:
            todo = todo[: a.limit]
        shas = [c.sha for c in todo]
    else:
        shas = [
            gitout("rev-parse", "--verify", h + "^{commit}").strip() for h in a.commits
        ]
    if not a.dry_run:
        require_clean(repo)
    run_queue(repo, shas, {}, a.force, a.dry_run, not a.no_lint)


def cmd_skip(repo, a):
    os.makedirs(os.path.dirname(os.path.abspath(repo.skipfile)), exist_ok=True)
    with open(repo.skipfile, "a") as f:
        for h in a.commits:
            c = get_commit(repo, h)
            reason = f" {a.message}" if a.message else ""
            f.write(f"{c.sha} #{reason} ({c.subject})\n")
            print(f"skipped {c.short} {c.subject}")
    rel = os.path.relpath(repo.skipfile)
    if not rel.startswith(".."):
        print(
            f"\nrecorded in {rel}, commit it with:\n"
            f"  git add {rel} && git commit -m 'Skip upstream commits' -- {rel}"
        )


def default_skip_file():
    return os.environ.get("CHIMERA_SYNC_SKIP")


def main():
    p = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    p.add_argument("--upstream", default="upstream/master")
    p.add_argument("--base", help="start of the range (default: merge-base)")
    p.add_argument("--skip-file", default=default_skip_file(), help="default: ./" + SKIPFILE)
    p.set_defaults(func=cmd_pending, files=False, dates=False)
    sub = p.add_subparsers()
    sp = sub.add_parser("pending", help="list commits not applied yet")
    sp.set_defaults(func=cmd_pending)
    sp.add_argument("--files", action="store_true", help="list paths")
    sp.add_argument("--dates", action="store_true", help="show commit dates")
    sp = sub.add_parser("show", help="show what pick would apply")
    sp.set_defaults(func=cmd_show)
    sp.add_argument("commit")
    sp = sub.add_parser("pick", help="apply commits")
    sp.set_defaults(func=cmd_pick)
    sp.add_argument("commits", nargs="*")
    sp.add_argument("--pending", action="store_true")
    sp.add_argument("-n", "--limit", type=int)
    sp.add_argument("--dry-run", action="store_true")
    sp.add_argument(
        "--force", action="store_true", help="pick even if it looks applied"
    )
    sp.add_argument("--no-lint", action="store_true", help="skip cbuild lint")
    sp = sub.add_parser("continue", help="commit a resolved pick, go on")
    sp.set_defaults(func=cmd_continue)
    sp.add_argument("--no-lint", action="store_true", help="skip cbuild lint")
    sp = sub.add_parser("abort", help="drop a pick in progress")
    sp.set_defaults(func=cmd_abort)
    sp = sub.add_parser("skip", help="mark commits as not wanted")
    sp.set_defaults(func=cmd_skip)
    sp.add_argument("commits", nargs="+")
    sp.add_argument("-m", "--message")
    a = p.parse_args()
    if a.func is cmd_pick and not (a.commits or a.pending):
        p.error("pick needs commits or --pending")
    a.func(Repo(a), a)


if __name__ == "__main__":
    main()
