#!/bin/sh
#
# mail-secret - Print or store a mail secret for mbsync, msmtp and mail-oauth2
#
# Usage: mail-secret [-w] <name>
#
#   -w  store the secret read from stdin (its first line) instead of
#       printing it, replacing any previous one
#
#   personal            app password of rbgarga@gmail.com
#   freebsd-gmail       app password of garga.bsd@gmail.com
#   freebsd-smtp        password of the garga/mail principal (smtp.FreeBSD.org)
#   work-oauth-client   OAuth2 client of garga@netgate.com: "<id> <secret>"
#   work-oauth-refresh  OAuth2 refresh token of garga@netgate.com, stored by
#                       `mail-oauth2 --authorize work`
#
# Used as PassCmd in ~/.mbsyncrc, passwordeval in ~/.config/msmtp/config
# and by mail-oauth2, so the secrets are never in this repo.  On macOS
# they are read from the Keychain, items created with:
#   security add-generic-password -a "$USER" -s mail-<name> -w
# On other systems they are read from a file that only the owner can
# access (no group/other permissions, otherwise the script refuses to use
# it):
#   mkdir -p ~/.config/mail/secrets && chmod 700 ~/.config/mail/secrets
#   (umask 077; cat > ~/.config/mail/secrets/<name>)
#
# Environment:
#   MAIL_SECRETS_DIR  Secret files directory on non-macOS systems
#                     (default: ~/.config/mail/secrets)

set -eu

die() {
	echo "$(basename "$0"): $*" >&2
	exit 1
}

usage() {
	die "usage: $(basename "$0") [-w] personal|freebsd-gmail|freebsd-smtp|work-oauth-client|work-oauth-refresh"
}

write=
while getopts w opt; do
	case "${opt}" in
		w) write=1 ;;
		*) usage ;;
	esac
done
shift $((OPTIND - 1))

[ $# -eq 1 ] || usage

name=$1
case "${name}" in
	personal|freebsd-gmail|freebsd-smtp|work-oauth-client|work-oauth-refresh) ;;
	*) usage ;;
esac

if [ -n "${write}" ]; then
	IFS= read -r secret || [ -n "${secret}" ] || die "no secret on stdin"
	[ -n "${secret}" ] || die "empty secret"
fi

if [ "$(uname -s)" = Darwin ]; then
	if [ -n "${write}" ]; then
		# The command goes to `security -i` on stdin, so the secret never
		# shows up in the process list; that input is split on blanks and
		# quotes, so only secrets without them are taken
		case "${secret}" in
			*[[:space:]\"\'\\]*)
				die "secret has blanks or quotes, add it with security(1)" ;;
		esac
		printf 'add-generic-password -U -a %s -s mail-%s -w %s\n' \
		    "${USER}" "${name}" "${secret}" | security -i >/dev/null \
		    || die "unable to store mail-${name} in Keychain"
	else
		security find-generic-password -a "${USER}" -s "mail-${name}" -w \
		    2>/dev/null \
		    || die "secret not found in Keychain (mail-${name})"
	fi
else
	dir=${MAIL_SECRETS_DIR:-${XDG_CONFIG_HOME:-${HOME}/.config}/mail/secrets}
	file=${dir}/${name}
	if [ -n "${write}" ]; then
		umask 077
		mkdir -p "${dir}" || die "unable to create ${dir}"
		printf '%s\n' "${secret}" > "${file}.tmp" \
		    || die "unable to write ${file}.tmp"
		mv "${file}.tmp" "${file}" || die "unable to write ${file}"
		exit 0
	fi
	[ -f "${file}" ] || die "secret file not found (${file})"
	# ls is the portable way to read the mode (stat differs on BSD/GNU)
	# shellcheck disable=SC2012
	[ "$(ls -ld "${file}" | cut -c5-10)" = "------" ] \
	    || die "${file} must not be accessible by group or others"
	# Only the first line, so a trailing newline or comment never ends up
	# in the password
	head -n 1 "${file}" || die "unable to read ${file}"
fi
