#!/bin/sh
#
# mail-label - Delete or unlabel, under one label, the messages neomutt
# has tagged for it
#
# Usage: mail-label delete|unlabel <account>/<label>
#
#   delete   move the files under that label of the messages tagged
#            pending-label to the account's Trash; Gmail then trashes
#            the messages
#   unlabel  remove the files under that label of the messages tagged
#            pending-label; Gmail then only removes the label
#
#   mail-label unlabel freebsd/freebsd/reviews
#
# Used by the neomutt label view macros: they tag the message, which
# hides it from the index right away (the views leave pending-label
# out), and then run this from an <enter-command>, so neomutt never
# leaves the screen.  One line, the outcome, is printed for neomutt to
# show; errors go there too.
#
# A label view is a notmuch query, so neomutt's own delete could remove
# whichever copy of the message notmuch handed it, possibly the All Mail
# one, which would delete it for good in Gmail.  This only ever touches
# the files of the tagged messages under ~/Mail/<account>/<label>, and
# leaves alone a message that has none (e.g. the user's own reply shown
# in the thread; it shows up again when the view is reopened).  The tag
# is taken off on the way out, also after an error, so no message stays
# hidden.  mbsync carries the change to Gmail on the next sync.

set -eu

die() {
	echo "$(basename "$0"): $*"
	exit 1
}

usage() {
	die "usage: $(basename "$0") delete|unlabel <account>/<label>"
}

[ $# -eq 2 ] || usage
action=$1
folder=$2

case "${action}" in
	delete|unlabel) ;;
	*) usage ;;
esac
case "${folder}" in
	*..*|*\"*) die "invalid label: ${folder}" ;;
	personal/?*|freebsd/?*|work/?*) ;;
	*) die "not a label view: ${folder}" ;;
esac
account=${folder%%/*}
case "${folder#*/}" in
	inbox|all|sent|drafts|trash|spam) die "not a label view: ${folder}" ;;
esac
tag=pending-label
trap 'notmuch tag "-${tag}" -- "tag:${tag}"' EXIT

root=$(notmuch config get database.path) || die "notmuch is not configured"
dir=${root}/${folder}
trash=${root}/${account}/trash
[ "${action}" = unlabel ] || [ -d "${trash}/cur" ] \
    || die "no Trash Maildir (${trash})"

ids=$(notmuch search --output=messages "tag:${tag}") \
    || die "notmuch search failed"
[ -n "${ids}" ] || die "no message tagged ${tag}"

done=0
skipped=0
for id in ${ids}; do
	# notmuch prints every file of the message (All Mail, INBOX, the
	# other labels), so keep only the ones in this label's Maildir
	files=$(notmuch search --output=files "${id}" | awk \
	    -v cur="${dir}/cur/" -v new="${dir}/new/" \
	    'index($0, cur) == 1 || index($0, new) == 1')
	if [ -z "${files}" ]; then
		skipped=$((skipped + 1))
		continue
	fi
	printf '%s\n' "${files}" | while IFS= read -r file; do
		if [ "${action}" = delete ]; then
			# Drop mbsync's UID from the name, it belongs to the
			# old folder
			name=$(basename "${file}" | sed 's/,U=[0-9]*//')
			sub=$(basename "$(dirname "${file}")")
			mv "${file}" "${trash}/${sub}/${name}"
		else
			rm "${file}"
		fi
	done
	done=$((done + 1))
done

notmuch new --quiet

case "${action}" in
	delete) what="moved to Trash" ;;
	*) what="unlabeled" ;;
esac
if [ ${skipped} -gt 0 ]; then
	echo "${done} ${what}, ${skipped} not under ${folder} left alone"
else
	echo "${done} ${what}"
fi
