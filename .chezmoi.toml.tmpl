{{- /* Map hostnames to profiles. Unknown hosts default to "ssh".
   Add new hosts here, one line per host: "hostname" "desktop"|"ssh" */ -}}
{{- $profiles := dict
      "e14" "desktop"
      "garga-chimera-dev" "ssh"
      "garga-freebsd-dev" "ssh"
      "garga-noble-dev" "ssh"
      "garga-pfsense-dev" "ssh"
      "garga-resolute-dev" "ssh"
      "garga-trixie-dev" "ssh"
      "kvm-host-1" "ssh"
      "kvm-host-2" "ssh"
      "kvm-host-3" "ssh"
      "m2" "desktop"
      "pfsense-build-test-amd64-1" "ssh"
      "pfsense-build-test-amd64-2" "ssh"
      "pfsense-build-test-aarch64-1" "ssh"
      "pfsense-build-test-aarch64-2" "ssh"
      "pfsense-build-release-amd64-1" "ssh"
      "pfsense-build-release-amd64-2" "ssh"
      "pfsense-build-release-aarch64-1" "ssh"
      "pfsense-build-release-aarch64-2" "ssh"
      "tnsr-build-ubuntu-amd64-1" "ssh"
      "tnsr-build-ubuntu-amd64-2" "ssh"
      "tnsr-build-ubuntu-amd64-3" "ssh"
      "tnsr-build-ubuntu-amd64-4" "ssh"
      "tnsr-build-ubuntu-amd64-5" "ssh"
      "tnsr-build-ubuntu-amd64-6" "ssh"
      "tnsr-build-ubuntu-amd64-7" "ssh"
      "tnsr-build-ubuntu-arm64-1" "ssh"
      "tnsr-build-ubuntu-arm64-2" "ssh"
      "tnsr-build-ubuntu-arm64-3" "ssh"
      "tnsr-build-ubuntu-arm64-4" "ssh"
-}}
{{- /* macOS: the DHCP-assigned hostname changes with the network (mac vs
   m2), so key the map on the stable Bonjour name instead */ -}}
{{- $host := .chezmoi.hostname -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $host = output "scutil" "--get" "LocalHostName" | trim -}}
{{- end -}}
{{- $profile := "ssh" -}}
{{- if hasKey $profiles $host -}}
{{- $profile = index $profiles $host -}}
{{- end -}}
{{- /* Hosts running the poudriere nginx frontend; gates the nginx config
   install script. Add hostnames here, e.g. "e14" */ -}}
{{- $poudriere := list "garga-freebsd-dev" -}}

[data]
    profile = "{{ $profile }}"
    desktop = {{ eq $profile "desktop" }}
    poudriere = {{ has $host $poudriere }}

    # SSH agent forwarding is off. Set to true (and run `chezmoi init`) to
    # generate ForwardAgent entries in ~/.ssh/agent_forward.
    forward_agent = false

    # Extra hosts (not chezmoi machines) that also get agent forwarding
    # (only used when forward_agent = true)
    forward_extra = ["tnsr-build-*"]

    # Full hostname -> profile map. Consumed by ~/.ssh/agent_forward:
    # ssh-profile hosts get agent forwarding, desktops hold the keys.
    [data.hosts]
{{- range $host, $p := $profiles }}
    "{{ $host }}" = "{{ $p }}"
{{- end }}
