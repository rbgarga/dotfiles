# nightly-releases
# auto-update-channel = tip

# Initial window size (columns and lines)
window-height = 27
window-width = 116

# Initial window directory
working-directory = home
window-inherit-working-directory = false
tab-inherit-working-directory = false
split-inherit-working-directory = false

# Do not move cursor on mouse click
cursor-click-to-move = false

# Colors - Gruvbox dark (medium), matching gruvbox.nvim's palette
background = #282828
foreground = #ebdbb2
cursor-color = #ebdbb2
cursor-text = #282828
selection-background = #665c54
selection-foreground = #ebdbb2
palette = 0=#282828
palette = 1=#cc241d
palette = 2=#98971a
palette = 3=#d79921
palette = 4=#458588
palette = 5=#b16286
palette = 6=#689d6a
palette = 7=#a89984
palette = 8=#928374
palette = 9=#fb4934
palette = 10=#b8bb26
palette = 11=#fabd2f
palette = 12=#83a598
palette = 13=#d3869b
palette = 14=#8ec07c
palette = 15=#ebdbb2
background-opacity = 0.95
background-blur-radius = 20

# Fonts
font-family = MesloLGMDZ Nerd Font Mono
font-size = 18
font-thicken = true
font-thicken-strength = 0

# Disable ligatures
font-feature = -calt
font-feature = -clig
font-feature = -liga

# macOS specific tweaks
macos-titlebar-proxy-icon = hidden
macos-option-as-alt = true
window-padding-balance = true

# Shell integration
shell-integration = zsh
shell-integration-features = no-cursor,sudo,ssh-env,title

# Cursor
cursor-style-blink = true
mouse-hide-while-typing = true

# Clipboard
clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard
clipboard-paste-protection = false
clipboard-trim-trailing-spaces = true

# Quick terminal (quake-style dropdown from the top edge)
keybind = ctrl+shift+space=toggle_quick_terminal
keybind = global:ctrl+shift+space=toggle_quick_terminal

# Forward Cmd+PgUp/PgDn to the app as Alt+PgUp/PgDn (tmux binds these for
# pane history scrolling); overrides ghostty's local Cmd+PgUp scrollback
keybind = super+page_up=text:\x1b[5;3~
keybind = super+page_down=text:\x1b[6;3~
