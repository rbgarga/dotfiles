{{- $open := "xdg-open" }}{{ if eq .chezmoi.os "darwin" }}{{ $open = "open" }}{{ end -}}
# mailcap for neomutt: HTML is shown inline with w3m (auto_view), and
# images, audio, video and application files open in the default app
# (Enter on the attachment, or V / view-mailcap).  The file is copied
# first since neomutt removes it as soon as the command returns, before
# the app has read it.  A type only matches itself or <type>/*: mailcap
# has no */*.  The other text types stay in neomutt's pager.

text/html; d=$(mktemp -d -t neomutt.XXXXXX) && cp %s "$d/message.html" && {{ $open }} "$d/message.html"; nametemplate=%s.html
text/html; w3m -I %{charset} -T text/html -dump -o display_link_number=1; copiousoutput
{{- range list "image" "audio" "video" "application" }}
{{ . }}/*; d=$(mktemp -d -t neomutt.XXXXXX) && cp %s "$d/" && {{ $open }} "$d/$(basename %s)"
{{- end }}
