{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "ubuntu" "debian") -}}
#!/bin/sh
# onchange: {{ includeTemplate ".apt-packages" . | sha256sum }}
set -e

export DEBIAN_FRONTEND=noninteractive

sudo apt-get update -y

sudo apt-get install -y{{ range $pkg := splitList "\n" (includeTemplate ".apt-packages" .) }}{{ if $pkg }} {{ $pkg }}{{ end }}{{ end }}

# node/npm: respect an existing installation (e.g. NodeSource, which bundles
# npm and conflicts with the distro npm package); distro pair only if missing
if ! command -v node >/dev/null 2>&1; then
    sudo apt-get install -y nodejs npm
else
    echo "node $(node --version) already present, skipping nodejs/npm"
fi

# lazygit is missing from older releases; best effort only
sudo apt-get install -y lazygit >/dev/null 2>&1 || \
    echo "NOTE: lazygit not available in this release, skipping"

# Resolute+ defaults to Rust coreutils (uutils); restore GNU coreutils.
# Both provider packages only exist on recent Ubuntu releases, so older
# releases and Debian skip this automatically.
if apt-cache show coreutils-from-gnu >/dev/null 2>&1 && \
   apt-cache show coreutils-from-uutils >/dev/null 2>&1; then
    sudo apt-get install -y coreutils-from-gnu coreutils-from-uutils- \
        --allow-remove-essential
fi

# Distro nvim (noble: 0.9.x, trixie: 0.10.x) is too old for current LazyVim.
# Install 'bob' (nvim version manager); the nvim shim lands in ~/.local/bin, which
# precedes /usr/bin in PATH (prezto zprofile).
mkdir -p "$HOME/.local/bin"
# Pin a specific bob release and verify its checksum before running it;
# upgrades are deliberate edits to this block
bobver=v4.1.7
case "{{ .chezmoi.arch }}" in
    amd64) asset=bob-linux-x86_64.zip; sum=a3e125379a99e4a82faf2c335c6fb85de694a112cf32ab085c10dd59dffd0a78 ;;
    arm64) asset=bob-linux-arm.zip; sum=dc9286bc169f25c3eda633e44ea12b2bc6e18d8f2d096c670fd34929bc4e4ec9 ;;
    *) echo "ERROR: unsupported architecture {{ .chezmoi.arch }}" >&2; exit 1 ;;
esac
curl -fsSL -o /tmp/bob.zip "https://github.com/MordechaiHadad/bob/releases/download/$bobver/$asset"
echo "$sum  /tmp/bob.zip" | sha256sum -c - >/dev/null || {
    echo "ERROR: bob checksum mismatch, aborting" >&2
    rm -f /tmp/bob.zip
    exit 1
}
unzip -oq /tmp/bob.zip -d /tmp/bob-extract
mv -f "$(find /tmp/bob-extract -type f -name bob | head -1)" "$HOME/.local/bin/bob"
chmod 0755 "$HOME/.local/bin/bob"
rm -rf /tmp/bob.zip /tmp/bob-extract

"$HOME/.local/bin/bob" install stable
"$HOME/.local/bin/bob" use stable

# bob 4.x does not create the nvim shim itself; symlink it into PATH
ln -sf "$HOME/.local/share/bob/nvim-bin/nvim" "$HOME/.local/bin/nvim"
{{- end -}}
