{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "chimera") -}}
#!/bin/sh
# onchange: {{ includeTemplate ".apk-packages" . | sha256sum }}
set -e

# Chimera uses doas by default; fall back to sudo
if command -v doas >/dev/null 2>&1; then
    PRIV=doas
elif command -v sudo >/dev/null 2>&1; then
    PRIV=sudo
else
    echo "ERROR: neither doas nor sudo available" >&2
    exit 1
fi

# Install one-by-one so a single unavailable package does not abort the rest;
# Chimera is musl-based, so expect Mason glibc prebuilts to fail at runtime and
# rely on system packages where the ports carry them.
for pkg in{{ range $pkg := splitList "\n" (includeTemplate ".apk-packages" .) }}{{ if $pkg }} {{ $pkg }}{{ end }}{{ end }}
do
    $PRIV apk add "$pkg" || \
        echo "WARNING: failed to install $pkg - not in Chimera ports? adjust .apk-packages"
done
{{- end -}}
