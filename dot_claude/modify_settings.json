{{/* chezmoi:modify-template */}}
{{- /* Claude Code rewrites settings.json itself (model, permissions, ...),
       so only set the keys managed here and keep everything else. The theme
       is only a default: a theme picked later with /theme is kept. */ -}}
{{- $settings := dict -}}
{{- if .chezmoi.stdin -}}
{{-   $settings = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- if or (not (hasKey $settings "theme")) (eq (get $settings "theme") "auto") -}}
{{-   $_ := set $settings "theme" "custom:gruvbox" -}}
{{- end -}}
{{- /* Same for the status line: only a default, a later edit is kept. */ -}}
{{- if not (hasKey $settings "statusLine") -}}
{{-   $_ := set $settings "statusLine" (dict "type" "command" "command" "~/.claude/statusline.sh") -}}
{{- end -}}
{{ toPrettyJson $settings | trim }}
